{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.eidolon.live/device-foundation/v1/body-mesh/schemas.schema.json",
  "title": "Eidolon Device Foundation V1 Body Mesh schemas",
  "$defs": {
    "EnsureMount": {
      "type": "object",
      "additionalProperties": false,
      "required": ["device_ref", "expected_revision", "spec"],
      "properties": {
        "device_ref": { "$ref": "../common/schemas.schema.json#/$defs/DeviceRef" },
        "expected_revision": { "type": "integer", "minimum": 0 },
        "spec": {
          "type": "object",
          "additionalProperties": false,
          "required": ["display_name", "space_id", "enabled", "policy_refs"],
          "properties": {
            "display_name": { "type": "string", "minLength": 1, "maxLength": 128 },
            "space_id": {
              "oneOf": [
                { "$ref": "../common/schemas.schema.json#/$defs/Identifier" },
                { "type": "null" }
              ]
            },
            "enabled": { "type": "boolean" },
            "policy_refs": {
              "type": "array",
              "items": { "$ref": "../common/schemas.schema.json#/$defs/Identifier" },
              "uniqueItems": true
            }
          }
        }
      }
    },
    "EnsureMountResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mount_id", "revision", "active", "observed_device_ref"],
      "properties": {
        "mount_id": { "$ref": "../common/schemas.schema.json#/$defs/Identifier" },
        "revision": { "type": "integer", "minimum": 1 },
        "active": { "type": "boolean" },
        "observed_device_ref": { "$ref": "../common/schemas.schema.json#/$defs/DeviceRef" }
      }
    },
    "ReconcileEndpoints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mount_id", "expected_mount_revision", "accepted_manifest_digest", "endpoints"],
      "properties": {
        "mount_id": { "$ref": "../common/schemas.schema.json#/$defs/Identifier" },
        "expected_mount_revision": { "type": "integer", "minimum": 1 },
        "accepted_manifest_digest": {
          "$ref": "../common/schemas.schema.json#/$defs/Sha256Digest"
        },
        "endpoints": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["endpoint_id", "roles", "assignment_policy", "risk_class", "concurrency"],
            "properties": {
              "endpoint_id": { "$ref": "../common/schemas.schema.json#/$defs/Identifier" },
              "roles": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": { "enum": ["body", "sensor", "actuator", "gateway", "controller"] }
              },
              "assignment_policy": { "enum": ["required", "optional", "forbidden"] },
              "risk_class": { "enum": ["safe", "sensitive", "hazardous"] },
              "concurrency": { "enum": ["shared", "exclusive", "leased"] }
            }
          }
        }
      }
    },
    "ReplaceAssignment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "body_endpoint_id",
        "expected_assignment_revision",
        "companion_ref",
        "mode",
        "policy_refs"
      ],
      "properties": {
        "body_endpoint_id": { "$ref": "../common/schemas.schema.json#/$defs/Identifier" },
        "expected_assignment_revision": { "type": "integer", "minimum": 0 },
        "companion_ref": {
          "oneOf": [
            { "$ref": "../common/schemas.schema.json#/$defs/Identifier" },
            { "type": "null" }
          ]
        },
        "mode": { "const": "default" },
        "policy_refs": {
          "type": "array",
          "items": { "$ref": "../common/schemas.schema.json#/$defs/Identifier" },
          "uniqueItems": true
        }
      }
    },
    "ReplaceAssignmentResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assignment_id", "revision", "generation", "spec", "status"],
      "properties": {
        "assignment_id": { "$ref": "../common/schemas.schema.json#/$defs/Identifier" },
        "revision": { "type": "integer", "minimum": 1 },
        "generation": { "type": "integer", "minimum": 1 },
        "spec": { "type": "object" },
        "status": { "type": "object" }
      }
    }
  }
}
