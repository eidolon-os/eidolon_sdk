{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.eidolon.live/device-foundation/v1/device-control/schemas.schema.json",
  "title": "Eidolon Device Foundation V1 Device Control schemas",
  "$defs": {
    "PatchDesired": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "device_ref",
        "expected_twin_generation",
        "patch",
        "field_mask"
      ],
      "properties": {
        "device_ref": {
          "$ref": "../common/schemas.schema.json#/$defs/DeviceRef"
        },
        "expected_twin_generation": {
          "type": "integer",
          "minimum": 0
        },
        "patch": {
          "type": "object"
        },
        "field_mask": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$"
          }
        }
      }
    },
    "PatchDesiredResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "twin_generation",
        "desired_digest",
        "delivery_state"
      ],
      "properties": {
        "twin_generation": {
          "type": "integer",
          "minimum": 1
        },
        "desired_digest": {
          "$ref": "../common/schemas.schema.json#/$defs/Sha256Digest"
        },
        "delivery_state": {
          "const": "pending"
        }
      }
    },
    "ReportState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "device_ref",
        "report_id",
        "observed_twin_generation",
        "reported",
        "device_monotonic_time",
        "device_signature"
      ],
      "properties": {
        "device_ref": {
          "$ref": "../common/schemas.schema.json#/$defs/DeviceRef"
        },
        "report_id": {
          "$ref": "../common/schemas.schema.json#/$defs/Identifier"
        },
        "observed_twin_generation": {
          "type": "integer",
          "minimum": 0
        },
        "reported": {
          "type": "object"
        },
        "device_monotonic_time": {
          "type": "integer",
          "minimum": 0
        },
        "device_signature": {
          "$ref": "../common/schemas.schema.json#/$defs/P256RawSignature"
        }
      }
    },
    "CreateOperation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "device_ref",
        "operation_id",
        "operation_type",
        "target_ref",
        "preconditions",
        "deadline",
        "qos",
        "payload"
      ],
      "properties": {
        "device_ref": {
          "$ref": "../common/schemas.schema.json#/$defs/DeviceRef"
        },
        "operation_id": {
          "$ref": "../common/schemas.schema.json#/$defs/Identifier"
        },
        "operation_type": {
          "$ref": "../common/schemas.schema.json#/$defs/Identifier"
        },
        "target_ref": {
          "type": "object"
        },
        "preconditions": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "claim_generation",
            "trust_epoch",
            "target_revision"
          ],
          "properties": {
            "claim_generation": {
              "type": "integer",
              "minimum": 1
            },
            "trust_epoch": {
              "type": "integer",
              "minimum": 1
            },
            "target_revision": {
              "oneOf": [
                {
                  "type": "integer",
                  "minimum": 0
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        "deadline": {
          "type": "string",
          "format": "date-time"
        },
        "qos": {
          "enum": [
            "ack",
            "result"
          ]
        },
        "payload": {
          "type": "object"
        }
      }
    },
    "AckOperation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "device_ref",
        "operation_id",
        "ack_sequence",
        "state",
        "result_code",
        "result",
        "device_signature"
      ],
      "properties": {
        "device_ref": {
          "$ref": "../common/schemas.schema.json#/$defs/DeviceRef"
        },
        "operation_id": {
          "$ref": "../common/schemas.schema.json#/$defs/Identifier"
        },
        "ack_sequence": {
          "type": "integer",
          "minimum": 0
        },
        "state": {
          "enum": [
            "delivered",
            "running",
            "succeeded",
            "failed",
            "rejected"
          ]
        },
        "result_code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "result": {
          "oneOf": [
            {
              "type": "object"
            },
            {
              "type": "null"
            }
          ]
        },
        "device_signature": {
          "$ref": "../common/schemas.schema.json#/$defs/P256RawSignature"
        }
      }
    },
    "DeviceOperationKeyProof": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "device_instance_id",
        "enrollment_request_id",
        "public_key_spki",
        "possession_signature"
      ],
      "properties": {
        "device_instance_id": {
          "$ref": "../common/schemas.schema.json#/$defs/DeviceInstanceId"
        },
        "enrollment_request_id": {
          "$ref": "../common/schemas.schema.json#/$defs/Identifier"
        },
        "public_key_spki": {
          "type": "string",
          "minLength": 120,
          "maxLength": 256,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "possession_signature": {
          "$ref": "../common/schemas.schema.json#/$defs/P256RawSignature"
        }
      }
    },
    "DeviceLocalErasePayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "erase_scopes"
      ],
      "properties": {
        "erase_scopes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "owner-credentials",
              "owner-data",
              "network-profiles"
            ]
          }
        }
      }
    },
    "DeviceLocalEraseCommand": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract",
        "contract_version",
        "operation_id",
        "operation_type",
        "device_ref",
        "deadline",
        "payload"
      ],
      "properties": {
        "contract": {
          "const": "eidolon.device-foundation.device-operation"
        },
        "contract_version": {
          "const": "1.0"
        },
        "operation_id": {
          "$ref": "../common/schemas.schema.json#/$defs/Identifier"
        },
        "operation_type": {
          "const": "device-local.erase"
        },
        "device_ref": {
          "$ref": "../common/schemas.schema.json#/$defs/DeviceRef"
        },
        "deadline": {
          "type": "string",
          "format": "date-time"
        },
        "payload": {
          "$ref": "#/$defs/DeviceLocalErasePayload"
        }
      }
    },
    "DeviceLocalEraseAck": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract",
        "contract_version",
        "operation_id",
        "operation_type",
        "device_ref",
        "ack_sequence",
        "result",
        "result_code",
        "device_monotonic_time",
        "device_signature"
      ],
      "properties": {
        "contract": {
          "const": "eidolon.device-foundation.device-operation-ack"
        },
        "contract_version": {
          "const": "1.0"
        },
        "operation_id": {
          "$ref": "../common/schemas.schema.json#/$defs/Identifier"
        },
        "operation_type": {
          "const": "device-local.erase"
        },
        "device_ref": {
          "$ref": "../common/schemas.schema.json#/$defs/DeviceRef"
        },
        "ack_sequence": {
          "type": "integer",
          "minimum": 1
        },
        "result": {
          "enum": [
            "erased",
            "permanent-failure"
          ]
        },
        "result_code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "device_monotonic_time": {
          "type": "integer",
          "minimum": 0
        },
        "device_signature": {
          "$ref": "../common/schemas.schema.json#/$defs/P256RawSignature"
        }
      }
    },
    "DeviceLocalEraseOperationStatus": {
      "type": "object",
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "acknowledged"
              }
            }
          },
          "then": {
            "properties": {
              "terminal_result": {
                "const": "erased"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "expired"
              }
            }
          },
          "then": {
            "properties": {
              "terminal_result": {
                "const": "deadline-expired"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "permanent-failure"
              }
            }
          },
          "then": {
            "properties": {
              "terminal_result": {
                "const": "permanent-failure"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "enum": [
                  "accepted",
                  "pending",
                  "delivery-accepted"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "terminal_result": {
                "type": "null"
              }
            }
          }
        }
      ],
      "required": [
        "contract",
        "contract_version",
        "operation_id",
        "operation_type",
        "request_fingerprint",
        "device_ref",
        "created_at",
        "deadline",
        "state",
        "attempt_count",
        "terminal_result"
      ],
      "properties": {
        "contract": {
          "const": "eidolon.device-foundation.device-operation-status"
        },
        "contract_version": {
          "const": "1.0"
        },
        "operation_id": {
          "$ref": "../common/schemas.schema.json#/$defs/Identifier"
        },
        "operation_type": {
          "const": "device-local.erase"
        },
        "request_fingerprint": {
          "$ref": "../common/schemas.schema.json#/$defs/Sha256Digest"
        },
        "device_ref": {
          "$ref": "../common/schemas.schema.json#/$defs/DeviceRef"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "deadline": {
          "type": "string",
          "format": "date-time"
        },
        "state": {
          "enum": [
            "accepted",
            "pending",
            "delivery-accepted",
            "acknowledged",
            "expired",
            "permanent-failure"
          ]
        },
        "attempt_count": {
          "type": "integer",
          "minimum": 0
        },
        "terminal_result": {
          "oneOf": [
            {
              "enum": [
                "erased",
                "permanent-failure",
                "deadline-expired"
              ]
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "ManifestDocument": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manifest_id",
        "revision",
        "digest",
        "document"
      ],
      "properties": {
        "manifest_id": {
          "type": "string",
          "minLength": 3,
          "maxLength": 128
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "digest": {
          "$ref": "../common/schemas.schema.json#/$defs/Sha256Digest"
        },
        "document": {
          "$ref": "../common/schemas.schema.json#/$defs/DeviceCapabilityManifest"
        }
      }
    },
    "AssertDeviceManifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract",
        "contract_version",
        "device_ref",
        "manifest",
        "nonce",
        "public_key_spki",
        "device_signature"
      ],
      "properties": {
        "contract": {
          "const": "eidolon.device-foundation.manifest-assertion"
        },
        "contract_version": {
          "const": "1.0"
        },
        "device_ref": {
          "$ref": "../common/schemas.schema.json#/$defs/DeviceRef"
        },
        "manifest": {
          "$ref": "#/$defs/ManifestDocument"
        },
        "nonce": {
          "type": "string",
          "minLength": 16,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "public_key_spki": {
          "type": "string",
          "minLength": 120,
          "maxLength": 256,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "device_signature": {
          "$ref": "../common/schemas.schema.json#/$defs/P256RawSignature"
        }
      }
    },
    "DeviceManifestAcceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract",
        "contract_version",
        "device_ref",
        "nonce",
        "accepted",
        "outcome",
        "accepted_at"
      ],
      "properties": {
        "contract": {
          "const": "eidolon.device-foundation.manifest-acceptance"
        },
        "contract_version": {
          "const": "1.0"
        },
        "device_ref": {
          "$ref": "../common/schemas.schema.json#/$defs/DeviceRef"
        },
        "nonce": {
          "type": "string",
          "minLength": 16,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "accepted": {
          "$ref": "../common/schemas.schema.json#/$defs/ManifestRef"
        },
        "outcome": {
          "enum": [
            "accepted",
            "unchanged"
          ]
        },
        "accepted_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "ChannelBinding": {
      "description": "One channel an Authority relays to a Body, and the whole of what the Authority knows about it. `binding_format` names the vocabulary of `opaque_binding` and `opaque_binding` is base64 of a document in it; neither is read here, and that opacity is the point — what a room or a topic is belongs to the Channel. A Body picks the entry whose `binding_format` it implements and ignores the rest, so this object can carry a transport a given Body has never heard of without that being an error anywhere.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "channel_id",
        "purpose",
        "kinds",
        "binding_format",
        "issued_at_ms",
        "expires_at_ms",
        "opaque_binding"
      ],
      "properties": {
        "channel_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "purpose": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "kinds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32
          }
        },
        "binding_format": {
          "description": "A media type naming the vocabulary of `opaque_binding`, version included. The version lives inside this string, so a Body that does not implement the version must refuse the entry rather than parse it as the one it knows.",
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "issued_at_ms": {
          "type": "integer",
          "minimum": 0
        },
        "expires_at_ms": {
          "type": "integer",
          "exclusiveMinimum": 0
        },
        "opaque_binding": {
          "description": "base64 of the document `binding_format` names, standard alphabet with padding.",
          "type": "string",
          "minLength": 1,
          "maxLength": 131072
        }
      }
    },
    "DeviceConfigurationResult": {
      "description": "What a Body is told when it asks what it should be. `lifecycle_state` and the presence of a channel are two separate facts and must stay so: approved-with-no-channel is a real, expected state — the Authority holds the Claim and the Channel has not answered yet — and a Body that reads it as revoked, or as an error, gives up on an enrolment that is fine. `manifest` absent means the answer says nothing about which declaration the Authority holds; it never means it holds none.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation",
        "nonce",
        "device_ref",
        "lifecycle_state",
        "channels"
      ],
      "properties": {
        "operation": {
          "const": "device-control.configuration"
        },
        "nonce": {
          "description": "Echoed from the request, so a Body can tell this answer from a replay of the answer to an older question.",
          "type": "string",
          "minLength": 16,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "device_ref": {
          "$ref": "../common/schemas.schema.json#/$defs/DeviceRef"
        },
        "lifecycle_state": {
          "enum": [
            "approved",
            "revoked"
          ]
        },
        "manifest": {
          "$ref": "../common/schemas.schema.json#/$defs/ManifestRef"
        },
        "channels": {
          "description": "At most one. A Body holds one channel for as long as it is enrolled; a second entry would be a second answer to the question of where it lives.",
          "type": "array",
          "maxItems": 1,
          "items": {
            "$ref": "#/$defs/ChannelBinding"
          }
        }
      }
    }
  }
}
