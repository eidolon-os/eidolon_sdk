{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.eidolon.live/device-foundation/v1/events/schemas.schema.json",
  "title": "Eidolon Device Foundation V1 event schemas",
  "$defs": {
    "ClaimActivatedData": {
      "type": "object",
      "additionalProperties": false,
      "required": ["device_ref", "approval_decision_id", "activated_at"],
      "properties": {
        "device_ref": { "$ref": "../common/schemas.schema.json#/$defs/DeviceRef" },
        "approval_decision_id": { "$ref": "../common/schemas.schema.json#/$defs/Identifier" },
        "activated_at": { "type": "string", "format": "date-time" }
      }
    },
    "ClaimActivatedEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "specversion",
        "id",
        "source",
        "type",
        "subject",
        "time",
        "datacontenttype",
        "dataschema",
        "ownerdomainid",
        "aggregaterev",
        "correlationid",
        "causationid",
        "data"
      ],
      "properties": {
        "specversion": { "const": "1.0" },
        "id": { "$ref": "../common/schemas.schema.json#/$defs/Identifier" },
        "source": { "const": "urn:eidolon:authority:admission" },
        "type": { "const": "live.eidolon.device.claim-activated.v1" },
        "subject": { "type": "string", "pattern": "^device-instances/[A-Za-z][A-Za-z0-9._:-]*$" },
        "time": { "type": "string", "format": "date-time" },
        "datacontenttype": { "const": "application/json" },
        "dataschema": {
          "const": "https://contracts.eidolon.live/device-foundation/v1/events/claim-activated-data.schema.json"
        },
        "ownerdomainid": { "$ref": "../common/schemas.schema.json#/$defs/Identifier" },
        "aggregaterev": { "type": "integer", "minimum": 1 },
        "correlationid": { "$ref": "../common/schemas.schema.json#/$defs/Identifier" },
        "causationid": { "$ref": "../common/schemas.schema.json#/$defs/Identifier" },
        "data": { "$ref": "#/$defs/ClaimActivatedData" }
      }
    }
  }
}
