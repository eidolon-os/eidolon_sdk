{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.eidolon.live/device-foundation/v1/events/schemas.schema.json",
  "title": "Eidolon Device Foundation V1 event schemas",
  "$defs": {
    "AdmissionEventSource": { "const": "urn:eidolon:authority:admission" },
    "AdmissionEventType": {
      "enum": [
        "live.eidolon.device.enrollment-proposal-created.v1",
        "live.eidolon.device.enrollment-approved.v1",
        "live.eidolon.device.enrollment-rejected.v1",
        "live.eidolon.device.enrollment-expired.v1",
        "live.eidolon.device.enrollment-canceled.v1",
        "live.eidolon.device.claim-grant-delivered.v1",
        "live.eidolon.device.claim-grant-acknowledged.v1",
        "live.eidolon.device.claim-activated.v1",
        "live.eidolon.device.claim-suspended.v1",
        "live.eidolon.device.claim-resumed.v1",
        "live.eidolon.device.claim-revoked.v1",
        "live.eidolon.device.claim-trust-epoch-changed.v1",
        "live.eidolon.device.manifest-accepted.v1"
      ]
    },
    "ClaimActivatedData": {
      "type": "object",
      "additionalProperties": false,
      "required": ["device_ref", "business_owner_id", "manifest_ref", "approval_decision_id", "activated_at"],
      "properties": {
        "device_ref": { "$ref": "../common/schemas.schema.json#/$defs/DeviceRef" },
        "business_owner_id": { "$ref": "../common/schemas.schema.json#/$defs/BusinessOwnerId" },
        "manifest_ref": { "$ref": "../common/schemas.schema.json#/$defs/ManifestRef" },
        "approval_decision_id": { "$ref": "../common/schemas.schema.json#/$defs/Identifier" },
        "activated_at": { "type": "string", "format": "date-time" }
      }
    },
    "ClaimActivatedEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "specversion",
        "id",
        "source",
        "type",
        "subject",
        "time",
        "datacontenttype",
        "dataschema",
        "audience",
        "ownerdomainid",
        "aggregaterev",
        "correlationid",
        "causationid",
        "data"
      ],
      "properties": {
        "specversion": { "const": "1.0" },
        "id": { "$ref": "../common/schemas.schema.json#/$defs/Identifier" },
        "source": { "$ref": "#/$defs/AdmissionEventSource" },
        "type": { "const": "live.eidolon.device.claim-activated.v1" },
        "subject": { "type": "string", "pattern": "^device-instances/[A-Za-z0-9][A-Za-z0-9._:-]*$" },
        "time": { "type": "string", "format": "date-time" },
        "datacontenttype": { "const": "application/json" },
        "dataschema": {
          "const": "https://contracts.eidolon.live/device-foundation/v1/events/claim-activated-data.schema.json"
        },
        "audience": { "const": "eidolon-claim-consumers" },
        "ownerdomainid": { "$ref": "../common/schemas.schema.json#/$defs/OwnerDomainId" },
        "aggregaterev": { "type": "integer", "minimum": 1 },
        "correlationid": { "$ref": "../common/schemas.schema.json#/$defs/Identifier" },
        "causationid": { "$ref": "../common/schemas.schema.json#/$defs/Identifier" },
        "data": { "$ref": "#/$defs/ClaimActivatedData" }
      }
    },
    "ClaimRevokedData": {
      "type": "object",
      "additionalProperties": false,
      "required": ["device_ref", "reason", "revoked_at"],
      "properties": {
        "device_ref": { "$ref": "../common/schemas.schema.json#/$defs/DeviceRef" },
        "reason": { "type": "string", "minLength": 1, "maxLength": 256 },
        "revoked_at": { "type": "string", "format": "date-time" }
      }
    },
    "ClaimRevokedEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "specversion", "id", "source", "type", "subject", "time",
        "datacontenttype", "dataschema", "audience", "ownerdomainid", "aggregaterev",
        "correlationid", "causationid", "data"
      ],
      "properties": {
        "specversion": { "const": "1.0" },
        "id": { "$ref": "../common/schemas.schema.json#/$defs/Identifier" },
        "source": { "$ref": "#/$defs/AdmissionEventSource" },
        "type": { "const": "live.eidolon.device.claim-revoked.v1" },
        "subject": { "type": "string", "pattern": "^device-instances/[A-Za-z0-9][A-Za-z0-9._:-]*$" },
        "time": { "type": "string", "format": "date-time" },
        "datacontenttype": { "const": "application/json" },
        "dataschema": {
          "const": "https://contracts.eidolon.live/device-foundation/v1/events/claim-revoked-data.schema.json"
        },
        "audience": { "const": "eidolon-claim-consumers" },
        "ownerdomainid": { "$ref": "../common/schemas.schema.json#/$defs/OwnerDomainId" },
        "aggregaterev": { "type": "integer", "minimum": 1 },
        "correlationid": { "$ref": "../common/schemas.schema.json#/$defs/Identifier" },
        "causationid": { "$ref": "../common/schemas.schema.json#/$defs/Identifier" },
        "data": { "$ref": "#/$defs/ClaimRevokedData" }
      }
    },
    "ClaimEventCursor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stream_id", "stream_position"],
      "properties": {
        "stream_id": { "const": "admission-claims-v1" },
        "stream_position": { "type": "integer", "minimum": 0 }
      }
    },
    "ClaimEventStreamItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stream_position", "event"],
      "properties": {
        "stream_position": { "type": "integer", "minimum": 1 },
        "event": {
          "oneOf": [
            { "$ref": "#/$defs/ClaimActivatedEvent" },
            { "$ref": "#/$defs/ClaimRevokedEvent" }
          ]
        }
      }
    },
    "ClaimEventPage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stream_id", "requested_after", "events", "next_cursor",
        "high_watermark", "observed_at"
      ],
      "properties": {
        "stream_id": { "const": "admission-claims-v1" },
        "requested_after": { "$ref": "#/$defs/ClaimEventCursor" },
        "events": {
          "type": "array", "maxItems": 500,
          "items": { "$ref": "#/$defs/ClaimEventStreamItem" }
        },
        "next_cursor": { "$ref": "#/$defs/ClaimEventCursor" },
        "high_watermark": { "type": "integer", "minimum": 0 },
        "observed_at": { "type": "string", "format": "date-time" }
      }
    }
  }
}
