{
  "generator": "device-foundation-v1-catalog",
  "generator_version": "1.0",
  "canonical_root": "contracts/device_foundation/v1",
  "source_globs": [
    "**/*.schema.json",
    "examples/**/*.json",
    "golden/*.json",
    "profile/*.json",
    "state-vectors/*.json",
    "evidence/*.json",
    "requirements/*.json",
    "baseline/*.json",
    "conformance/*.py",
    "generation/templates/*",
    "generation/config.json",
    "generation/generate.py"
  ],
  "outputs": ["generated/catalog.json"],
  "binding_outputs": [
    {
      "language": "dart",
      "repo": "eidolon_client_mobile",
      "path": "lib/src/generated/device_foundation_v1.dart",
      "template": "generation/templates/device_foundation_v1.dart"
    },
    {
      "language": "cpp",
      "repo": "eidolon-client-esp32",
      "path": "main/eidolon/device_foundation_v1_generated.h",
      "template": "generation/templates/device_foundation_v1_generated.h"
    }
  ],
  "binding_targets": [
    { "language": "python", "status": "canonical-runtime", "owner": "eidolon_sdk" },
    { "language": "dart", "status": "generated", "owner": "eidolon_sdk" },
    { "language": "kotlin", "status": "transport-adapter-only", "owner": "eidolon_client_mobile" },
    { "language": "cpp", "status": "generated", "owner": "eidolon_sdk" }
  ],
  "policy": {
    "generated_files_are_read_only": true,
    "generation_drift_fails_ci": true,
    "handwritten_synonymous_dtos_allowed": false
  }
}
