    { "language": "dart", "status": "planned", "owner": "eidolon_client_mobile" },
    { "language": "kotlin", "status": "planned", "owner": "eidolon_client_mobile" },
    { "language": "cpp", "status": "planned", "owner": "eidolon-client-esp32" }
  ],
  "policy": {
    "generated_files_are_read_only": true,
    "generation_drift_fails_ci": true,
    "handwritten_synonymous_dtos_allowed": false
