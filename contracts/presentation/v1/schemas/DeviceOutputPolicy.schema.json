{
  "$defs": {
    "InputSelection": {
      "additionalProperties": false,
      "description": "Owner permission to send microphone audio, independent of response outputs.",
      "properties": {
        "microphone": {
          "default": false,
          "title": "Microphone",
          "type": "boolean"
        }
      },
      "title": "InputSelection",
      "type": "object"
    },
    "OutputSelection": {
      "additionalProperties": false,
      "properties": {
        "speech": {
          "default": false,
          "title": "Speech",
          "type": "boolean"
        },
        "dialogue_text": {
          "default": false,
          "title": "Dialogue Text",
          "type": "boolean"
        },
        "expression": {
          "default": false,
          "title": "Expression",
          "type": "boolean"
        },
        "audio_cue": {
          "default": false,
          "title": "Audio Cue",
          "type": "boolean"
        },
        "motion": {
          "default": false,
          "title": "Motion",
          "type": "boolean"
        }
      },
      "title": "OutputSelection",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Device interaction permissions sharing one atomic revision.\n\nThe wire name predates input controls. Inputs remain a separate selection;\nthey are never response outputs or part of presentation negotiation.\nNone preserves the historical microphone behavior for existing policies.",
  "properties": {
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "revision": {
      "maximum": 4294967295,
      "minimum": 1,
      "title": "Revision",
      "type": "integer"
    },
    "allowed": {
      "$ref": "#/$defs/OutputSelection"
    },
    "inputs": {
      "anyOf": [
        {
          "$ref": "#/$defs/InputSelection"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "revision",
    "allowed"
  ],
  "title": "DeviceOutputPolicy",
  "type": "object"
}
