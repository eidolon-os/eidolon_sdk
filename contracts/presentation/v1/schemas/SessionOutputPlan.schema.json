{
  "$defs": {
    "InputSelection": {
      "additionalProperties": false,
      "description": "Owner permission for what a device may take in, independent of response outputs.\n\n``camera`` is None for every device that has not declared the camera\ncontract: its camera use then follows from its Manifest, as it always has.",
      "properties": {
        "microphone": {
          "default": false,
          "title": "Microphone",
          "type": "boolean"
        },
        "camera": {
          "anyOf": [
            {
              "enum": [
                "off",
                "local",
                "capture"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Camera"
        }
      },
      "title": "InputSelection",
      "type": "object"
    },
    "OutputSelection": {
      "additionalProperties": false,
      "properties": {
        "speech": {
          "default": false,
          "title": "Speech",
          "type": "boolean"
        },
        "dialogue_text": {
          "default": false,
          "title": "Dialogue Text",
          "type": "boolean"
        },
        "expression": {
          "default": false,
          "title": "Expression",
          "type": "boolean"
        },
        "audio_cue": {
          "default": false,
          "title": "Audio Cue",
          "type": "boolean"
        },
        "motion": {
          "default": false,
          "title": "Motion",
          "type": "boolean"
        }
      },
      "title": "OutputSelection",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "session_id": {
      "maxLength": 96,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.:-]+$",
      "title": "Session Id",
      "type": "string"
    },
    "policy_revision": {
      "maximum": 4294967295,
      "minimum": 1,
      "title": "Policy Revision",
      "type": "integer"
    },
    "outputs": {
      "$ref": "#/$defs/OutputSelection"
    },
    "inputs": {
      "$ref": "#/$defs/InputSelection"
    },
    "expression_profile": {
      "anyOf": [
        {
          "const": "eidolon.face.v1",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Expression Profile"
    },
    "motion_profile": {
      "anyOf": [
        {
          "enum": [
            "stackchan.head.v1",
            "eidolon.motion.v1",
            "eidolon.motion.v2"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Motion Profile"
    },
    "motion_capabilities": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Motion Capabilities",
      "type": "array"
    },
    "device_capabilities": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Device Capabilities",
      "type": "array"
    }
  },
  "required": [
    "session_id",
    "policy_revision",
    "outputs"
  ],
  "title": "SessionOutputPlan",
  "type": "object"
}
